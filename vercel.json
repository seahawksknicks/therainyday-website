{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "redirects": [
    { "source": "/app", "destination": "/libations", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/drink", "destination": "/api/drink" },
    { "source": "/drink.html", "destination": "/api/drink" }
  ]
}
