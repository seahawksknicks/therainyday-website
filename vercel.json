{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/libations",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/dashboard.html",
      "destination": "/api/dashboard"
    },
    {
      "source": "/drink",
      "destination": "/api/drink"
    },
    {
      "source": "/drink.html",
      "destination": "/api/drink"
    }
  ],
  "functions": {
    "api/dashboard.js": {
      "includeFiles": "api/_dashboard/data.json"
    }
  }
}
